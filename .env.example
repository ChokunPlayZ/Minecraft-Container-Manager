# Bind address for the MCM web/API server (host:port).
MCM_ADDR=:8080

# Host port range allocated for Minecraft server containers.
MCM_PORT_RANGE=25565-25665

# Host directory bind-mounted into the panel container at /data for persistent
# storage, and used as the host-side bind source when provisioning server
# containers. Defaults to ${PWD}/data (a real folder next to docker-compose.yml,
# no auto-created docker volume). Set this to an absolute host path to relocate
# data. For non-Docker (systemd) installs this key is ignored; use MCM_DATA_DIR
# as the process data dir instead.
MCM_DATA_DIR_HOST=${PWD}/data

# Process/container-side data directory the panel reads and writes itself. In
# Docker the compose file pins this to /data (the mount point). On bare metal
# set this to the process data directory (default ./data).
MCM_DATA_DIR=./data

# SQLite database file path inside the panel container (the host copy lands
# under MCM_DATA_DIR_HOST). Leave unset to default to $MCM_DATA_DIR/mcm.db.
MCM_DB_PATH=/data/mcm.db

# Docker daemon endpoint used to manage Minecraft containers.
DOCKER_HOST=unix:///var/run/docker.sock

# UID:GID the MCM process runs as inside the container and that own the data
# directory. Set to match your host user (e.g. 501:20 on macOS) so bind-mounted
# data stays readable/writable by you.
PUID=1000
PGID=1000

# Secret used to sign session cookies. Replace with a long random string.
MCM_SESSION_SECRET=change-me-to-a-long-random-string

# TLS termination. Set MCM_TLS_CERT and MCM_TLS_KEY to a PEM cert/key pair to
# enable HTTPS. When enabled, MCM_TLS_REDIRECT (default true) 301-redirects
# plain HTTP traffic on MCM_TLS_REDIRECT_ADDR (default :80) to HTTPS.
MCM_TLS_CERT=
MCM_TLS_KEY=
MCM_TLS_REDIRECT=true
MCM_TLS_REDIRECT_ADDR=:80

# Login rate limiting and lockout.
MCM_LOGIN_MAX_ATTEMPTS=5
MCM_LOGIN_LOCKOUT=15m

# General per-client rate limiting for state-changing requests.
MCM_RATE_LIMIT_MAX=100
MCM_RATE_LIMIT_WINDOW=1m

# Default resource limits for new servers (0 disables).
MCM_DEFAULT_CPU_LIMIT=0
MCM_DEFAULT_MEMORY_MB=0

# Docker image used to run Minecraft server containers (itzg/minecraft-server).
MCM_SERVER_IMAGE=itzg/minecraft-server

# S3-compatible backup storage. Leave MCM_S3_ENDPOINT empty to disable backups.
MCM_S3_ENDPOINT=
MCM_S3_ACCESS_KEY=
MCM_S3_SECRET_KEY=
MCM_S3_BUCKET=
MCM_S3_REGION=us-east-1

# Container timezone.
TZ=UTC
