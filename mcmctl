#!/usr/bin/env bash
# Per-user Linux installation and management for MCM. No elevated privileges.
set -Eeuo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/mcm"
BIN_DIR="${MCM_BIN_DIR:-$HOME/.local/bin}"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
CONFIG="$CONFIG_DIR/mcm.env"
STATE="$CONFIG_DIR/install.conf"
UNIT="$UNIT_DIR/mcm.service"
STAGING=""
BUILD_CONTAINER=""
ENGINE=""
SOURCE_DIR=""
CONFIG_WORK_DIR=""
ORIGINAL_CONFIG=""
ANSWER=""
EXISTING_ENGINE=""
SETTINGS_SAVED=false

say() { printf '%s\n' "$*"; }
die() { say "Error: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "Install $1 first, then retry."; }
cleanup() {
    if [[ -n "$BUILD_CONTAINER" && -n "$ENGINE" ]]; then
        "$ENGINE" rm -f "$BUILD_CONTAINER" >/dev/null 2>&1 || true
    fi
    [[ -z "$STAGING" ]] || rm -rf -- "$STAGING"
    [[ -z "$CONFIG_WORK_DIR" ]] || rm -rf -- "$CONFIG_WORK_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

usage() {
    cat <<'USAGE'
Usage: ./mcmctl install [--interactive|--non-interactive] [--runtime podman|docker]
                       [--data-dir /absolute/path] [--backup-dir /absolute/path] [--port 8080]
       mcmctl start|stop|restart|status|logs|enable|disable
       mcmctl update [--local]
       mcmctl config [--interactive|--editor]
       mcmctl backup|rollback|uninstall

install    Build the complete app, create config, and start a user service.
           A terminal opens guided setup; flags become prompt defaults.
  --interactive      Always show the step-by-step setup (also with piped input).
  --non-interactive  Use existing settings, flags, and defaults without prompts.
update     Fast-forward the source checkout, build, back up, and restart.
  --local  Build the current checkout without fetching or changing Git files.
config     Edit settings step by step, review, save, and optionally restart.
  --editor Open persistent settings in $EDITOR (default: vi) instead.
backup     Save the panel database, settings, and installed version.
rollback   Restore the last backup and restart the panel.
uninstall  Remove the service and installed commands; retain config and data.

Run as your normal Linux user. Podman is preferred when both engines exist.
Minecraft servers keep running when the panel is stopped or updated.
USAGE
}

# Read literal KEY=value settings without executing the file as shell code.
setting() {
    local key="$1" value="" line
    [[ -f "$CONFIG" ]] || return 0
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "$key="* ]]; then value="${line#*=}"; fi
    done < "$CONFIG"
    if [[ "$value" == \"*\" || "$value" == \'*\' ]]; then
        value="${value:1:${#value}-2}"
    fi
    printf '%s' "$value"
}

set_setting() {
    local key="$1" value="$2" line temp
    temp=$(mktemp "$CONFIG_DIR/.env.XXXXXX")
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == "$key="* ]] || printf '%s\n' "$line"
    done < "$CONFIG" > "$temp"
    printf '%s=%s\n' "$key" "$value" >> "$temp"
    chmod 600 "$temp"
    mv -f -- "$temp" "$CONFIG"
}

absolute_path() {
    [[ "$1" == /* ]] || die "Use an absolute path: $1"
    # Literal environment-file paths; avoid unsupported escaping/expansion.
    [[ "$1" != *[$'\n\r\\\"\047\$']* ]] || die "Path contains unsupported quotes, escapes, or shell variables: $1"
}

# Work on a private copy until the user has reviewed and accepted the settings.
begin_config_edit() {
    ORIGINAL_CONFIG="$CONFIG"
    CONFIG_WORK_DIR=$(mktemp -d "$CONFIG_DIR/.setup.XXXXXX")
    CONFIG="$CONFIG_WORK_DIR/mcm.env"
    if [[ -f "$ORIGINAL_CONFIG" ]]; then cp -p -- "$ORIGINAL_CONFIG" "$CONFIG"; else touch "$CONFIG"; fi
    chmod 600 "$CONFIG"
}

commit_config_edit() {
    local backup
    if [[ -f "$ORIGINAL_CONFIG" ]]; then
        mkdir -p "$CONFIG_DIR/backups"
        backup=$(mktemp -d "$CONFIG_DIR/backups/config-$(date +%Y%m%d-%H%M%S)-XXXXXX")
        cp -p -- "$ORIGINAL_CONFIG" "$backup/mcm.env"
        say "Previous settings saved: $backup/mcm.env"
    fi
    mv -f -- "$CONFIG" "$ORIGINAL_CONFIG"
    CONFIG="$ORIGINAL_CONFIG"
    SETTINGS_SAVED=true
}

cancel_setup() {
    if [[ "$SETTINGS_SAVED" == true ]]; then
        say 'Settings are saved. Apply when ready with: mcmctl restart'
    else
        say 'Setup cancelled. No settings were saved.'
    fi
    exit 0
}

input_ended() {
    if [[ "$SETTINGS_SAVED" == true ]]; then
        say 'Settings are saved. Apply when ready with: mcmctl restart'
        exit 0
    fi
    die 'Input ended. No settings were saved.'
}

read_answer() {
    local prompt="$1" secret="${2:-false}"
    printf '%s' "$prompt"
    if [[ "$secret" == true && -t 0 ]]; then
        if ! IFS= read -r -s ANSWER; then say ''; input_ended; fi
        say ''
    else
        IFS= read -r ANSWER || input_ended
    fi
    [[ "$ANSWER" != :cancel ]] || cancel_setup
}

valid_port() { [[ "$1" =~ ^[0-9]{1,5}$ ]] && ((10#$1 >= ${2:-1} && 10#$1 <= 65535)); }

valid_value() {
    local kind="$1" value="$2" host port first last ancestor
    case "$kind" in
        runtime)
            [[ "$value" == podman || "$value" == docker ]] || { say 'Choose podman or docker.'; return 1; }
            if [[ -n "$EXISTING_ENGINE" && "$value" != "$EXISTING_ENGINE" ]]; then
                say "Keep $EXISTING_ENGINE for existing containers. Engine migrations require updating the runtime and endpoint together manually."
                return 1
            fi
            command -v "$value" >/dev/null 2>&1 || { say "Install $value first (see docs/operations.md), or choose the other engine."; return 1; }
            ;;
        directory|database|certificate)
            if [[ "$value" != /* || "$value" == *[$'\n\r\\\"\047\$']* ]]; then
                say 'Use a literal absolute path, without quotes, escapes, or shell variables.'; return 1
            fi
            if [[ "$kind" == certificate ]]; then
                [[ -f "$value" && -r "$value" ]] || { say 'Choose an existing readable PEM file.'; return 1; }
                return 0
            fi
            ancestor="$value"
            if [[ "$kind" == database ]]; then
                if [[ -e "$value" && ( ! -f "$value" || ! -r "$value" || ! -w "$value" ) ]]; then
                    say 'Choose a readable, writable database file.'; return 1
                fi
                ancestor=$(dirname -- "$value")
            fi
            while [[ ! -e "$ancestor" ]]; do ancestor=$(dirname -- "$ancestor"); done
            [[ -d "$ancestor" && -w "$ancestor" && -x "$ancestor" ]] || { say 'Choose a writable directory (or a path below one).'; return 1; }
            ;;
        endpoint)
            case "$value" in
                /*|unix:///*|tcp://?*:*) ;;
                *) say 'Use unix:///absolute/socket/path, /absolute/socket/path, or tcp://host:port.'; return 1 ;;
            esac
            ;;
        address)
            host="${value%:*}"; port="${value##*:}"
            if [[ "$value" != *:* ]] || ! valid_port "$port" 1024 ||
                [[ "$host" == *[[:space:]/]* ]] ||
                { [[ "$host" == *:* ]] && [[ ! "$host" =~ ^\[[0-9a-fA-F:%.]+\]$ ]]; }; then
                say 'Use host:port, :port for all interfaces, or [IPv6]:port; ports must be 1024-65535.'; return 1
            fi
            ;;
        range)
            first="${value%-*}"; last="${value#*-}"
            if [[ "$value" != *-* ]] || ! valid_port "$first" 1024 || ! valid_port "$last" 1024 || ((10#$first > 10#$last)); then
                say 'Use start-end with ports 1024-65535, in ascending order.'; return 1
            fi
            ;;
        timezone)
            [[ "$value" != /* && "$value" != *..* && -f "/usr/share/zoneinfo/$value" ]] || { say 'Use an installed timezone such as UTC or Asia/Bangkok.'; return 1; }
            ;;
        number)
            [[ "$value" =~ ^[0-9]{1,9}$ ]] || { say 'Enter a whole number, 0 or greater.'; return 1; }
            ;;
        cpu)
            [[ "$value" =~ ^[0-9]{1,6}(\.[0-9]{1,6})?$ ]] || { say 'Enter a non-negative CPU count such as 0, 0.5, or 2.'; return 1; }
            ;;
        duration)
            [[ "$value" =~ ^([0-9]+(\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$ ]] || { say 'Use a duration such as 30s, 15m, or 1h30m.'; return 1; }
            ;;
        url)
            [[ "$value" =~ ^https?://[^/[:space:]]+[^[:space:]]*$ ]] || { say 'Use a full http:// or https:// URL.'; return 1; }
            ;;
        origins)
            local origin
            local -a origins
            IFS=',' read -r -a origins <<< "$value"
            for origin in "${origins[@]}"; do
                [[ "$origin" =~ ^https?://[^/[:space:]]+$ ]] || { say 'Use comma-separated http(s) origins with no path or spaces, for example https://panel.example.com:8080.'; return 1; }
            done
            ;;
        rpid)
            [[ "$value" =~ ^[a-zA-Z0-9.-]+$ ]] || { say 'Use the browser hostname, without a scheme, port, or path.'; return 1; }
            ;;
        image)
            [[ "$value" != *[[:space:]]* ]] || { say 'Image names cannot contain spaces.'; return 1; }
            ;;
    esac
}

prompt_setting() {
    local key="$1" label="$2" fallback="$3" kind="${4:-text}" optional="${5:-false}" secret="${6:-false}"
    local current display value
    current=$(setting "$key")
    [[ -n "$current" ]] || current="$fallback"
    while true; do
        display="${current:-empty}"
        if [[ "$secret" == true && -n "$current" ]]; then display='saved; hidden'; fi
        read_answer "$label [$display]: " "$secret"
        # Keep an existing credential byte-for-byte, including its file quoting.
        if [[ "$secret" == true && -z "$ANSWER" && -n "$current" ]]; then return 0; fi
        value="${ANSWER:-$current}"
        [[ "$optional" != true || "$ANSWER" != - ]] || value=""
        if [[ -z "$value" ]]; then
            [[ "$optional" == true ]] || { say 'A value is required.'; continue; }
        else
            # Keep the literal format understood by setting() and systemd.
            if [[ "$value" == *[$'\r\n\\\"\047']* || "$value" == [[:space:]]* || "$value" == *[[:space:]] ]]; then
                say 'Use a single line without wrapping spaces, quotes, or backslashes.'; continue
            fi
            if ! valid_value "$kind" "$value"; then continue; fi
        fi
        set_setting "$key" "$value"
        return 0
    done
}

ask_yes_no() {
    local label="$1" default="${2:-false}" hint='y/N'
    [[ "$default" != true ]] || hint='Y/n'
    while true; do
        read_answer "$label [$hint]: "
        case "${ANSWER:-$default}" in
            y|Y|yes|YES|true) ANSWER=true; return 0 ;;
            n|N|no|NO|false) ANSWER=false; return 0 ;;
            *) say 'Enter yes or no.' ;;
        esac
    done
}

wizard_step() {
    local step="$1" mode default previous_engine previous_endpoint
    say ''
    case "$step" in
        1)
            say 'Step 1/7 - Container engine'
            say 'Podman is recommended for rootless installs. Keep the engine used by existing Minecraft containers.'
            previous_engine=$(setting MCM_CONTAINER_RUNTIME)
            previous_endpoint=$(setting MCM_CONTAINER_HOST)
            prompt_setting MCM_CONTAINER_RUNTIME 'Container engine (podman/docker)' "$ENGINE" runtime
            ENGINE=$(setting MCM_CONTAINER_RUNTIME)
            if [[ "$ENGINE" == podman ]]; then
                default="unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
            else
                default="${DOCKER_HOST:-unix:///var/run/docker.sock}"
            fi
            if [[ -n "$previous_engine" && "$previous_engine" != "$ENGINE" ]]; then
                case "$previous_endpoint" in
                    "unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"|"${DOCKER_HOST:-unix:///var/run/docker.sock}")
                        set_setting MCM_CONTAINER_HOST "$default" ;;
                esac
            fi
            prompt_setting MCM_CONTAINER_HOST 'Container API endpoint' "$default" endpoint
            ;;
        2)
            say 'Step 2/7 - Storage'
            say 'Choose the existing data directory when reinstalling. Changing a path does not move its files.'
            prompt_setting MCM_DATA_DIR 'Server data directory' "${XDG_DATA_HOME:-$HOME/.local/share}/mcm" directory
            say 'Leave the database path empty to use <data directory>/mcm.db.'
            prompt_setting MCM_DB_PATH 'Separate database file (optional)' '' database true
            say 'Leave the backup path empty to use <data directory>/backups, or choose mounted backup media.'
            prompt_setting MCM_BACKUP_DIR 'Separate backup directory (optional)' '' directory true
            ;;
        3)
            say 'Step 3/7 - Network and browser access'
            say ':8080 listens on every interface; 127.0.0.1:8080 limits access to this host or a local proxy.'
            prompt_setting MCM_ADDR 'Panel listen address' :8080 address
            prompt_setting MCM_PORT_RANGE 'Minecraft host port range' 25565-25665 range
            prompt_setting TZ 'Panel and schedule timezone' UTC timezone
            say 'For passkeys, use the hostname and full origin(s) you will open in the browser. Empty origins are derived from the listen port at localhost.'
            prompt_setting MCM_WEB_AUTHN_RPID 'Passkey hostname' localhost rpid
            prompt_setting MCM_WEB_AUTHN_RP_ORIGIN 'Passkey browser origins (optional)' '' origins true
            prompt_setting MCM_WEB_AUTHN_RP_NAME 'Passkey display name' 'Minecraft Container Manager'
            ;;
        4)
            say 'Step 4/7 - HTTPS and sessions'
            mode=self-signed
            case "$(setting MCM_HTTP_ONLY)" in
                1|t|T|true|TRUE|True)
                    mode=http
                    case "$(setting MCM_TLS)" in 1|t|T|true|TRUE|True) mode=proxy ;; esac
                    ;;
                *) [[ -z "$(setting MCM_TLS_CERT)" ]] || mode=custom ;;
            esac
            say 'self-signed: automatic HTTPS; custom: your PEM files; proxy: HTTPS at a reverse proxy; http: local development.'
            while true; do
                read_answer "HTTPS mode (self-signed/custom/proxy/http) [$mode]: "
                mode="${ANSWER:-$mode}"
                case "$mode" in self-signed|custom|proxy|http) break ;; *) say 'Choose self-signed, custom, proxy, or http.'; mode=self-signed ;; esac
            done
            if [[ "$mode" == custom ]]; then
                prompt_setting MCM_TLS_CERT 'TLS certificate PEM file' '' certificate
                prompt_setting MCM_TLS_KEY 'TLS private key PEM file' '' certificate
            else
                set_setting MCM_TLS_CERT ''
                set_setting MCM_TLS_KEY ''
            fi
            if [[ "$mode" == self-signed || "$mode" == custom ]]; then
                set_setting MCM_HTTP_ONLY false
                set_setting MCM_TLS false
                default=false
                case "$(setting MCM_TLS_REDIRECT)" in 1|t|T|true|TRUE|True) default=true ;; esac
                ask_yes_no 'Redirect plain HTTP to HTTPS on the panel port?' "$default"
                set_setting MCM_TLS_REDIRECT "$ANSWER"
            else
                set_setting MCM_HTTP_ONLY true
                set_setting MCM_TLS_REDIRECT false
                [[ "$mode" != http ]] || say 'HTTP mode sends session traffic without encryption. Use it only on a trusted local connection.'
                default=false; [[ "$mode" != proxy ]] || default=true
                set_setting MCM_TLS "$default"
            fi
            say 'The session signing secret is kept automatically, or generated securely for a new install.'
            ;;
        5)
            say 'Step 5/7 - Defaults for new Minecraft servers'
            say '0 leaves a resource unlimited. Existing server limits are unchanged.'
            prompt_setting MCM_DEFAULT_CPU_LIMIT 'Default CPU limit' 0 cpu
            prompt_setting MCM_DEFAULT_MEMORY_MB 'Default memory limit (MiB)' 0 number
            prompt_setting MCM_SERVER_IMAGE 'Minecraft runtime image' docker.io/library/eclipse-temurin:21-jre-alpine image
            ;;
        6)
            say 'Step 6/7 - Optional services and login protection'
            default=false; [[ -z "$(setting MCM_S3_ENDPOINT)" ]] || default=true
            ask_yes_no 'Configure S3-compatible backup storage?' "$default"
            if [[ "$ANSWER" == true ]]; then
                prompt_setting MCM_S3_ENDPOINT 'S3 endpoint URL' '' url
                prompt_setting MCM_S3_BUCKET 'S3 bucket' ''
                prompt_setting MCM_S3_REGION 'S3 region' us-east-1
                prompt_setting MCM_S3_ACCESS_KEY 'S3 access key' '' text false true
                prompt_setting MCM_S3_SECRET_KEY 'S3 secret key' '' text false true
            else
                set_setting MCM_S3_ENDPOINT ''
            fi
            say 'A CurseForge API key enables checks performed by the panel.'
            prompt_setting CURSEFORGE_API_KEY 'CurseForge API key (optional)' '' text true true
            ask_yes_no 'Edit login and request rate limits?' false
            if [[ "$ANSWER" == true ]]; then
                prompt_setting MCM_LOGIN_MAX_ATTEMPTS 'Failed login attempts before lockout' 5 number
                prompt_setting MCM_LOGIN_LOCKOUT 'Login lockout duration' 15m duration
                prompt_setting MCM_RATE_LIMIT_MAX 'Requests per client per window' 100 number
                prompt_setting MCM_RATE_LIMIT_WINDOW 'Request rate window' 1m duration
            fi
            ;;
    esac
}

review_config() {
    local key label fallback value
    say ''
    say 'Step 7/7 - Review settings'
    while IFS='|' read -r key label fallback; do
        value=$(setting "$key")
        printf '  %s: %s\n' "$label" "${value:-$fallback}"
    done <<'FIELDS'
MCM_CONTAINER_RUNTIME|Container engine|
MCM_CONTAINER_HOST|Container API|
MCM_DATA_DIR|Server data|
MCM_DB_PATH|Database|<data directory>/mcm.db
MCM_BACKUP_DIR|Server backups|<data directory>/backups
MCM_ADDR|Panel listen address|
MCM_PORT_RANGE|Minecraft ports|
TZ|Timezone|
MCM_WEB_AUTHN_RPID|Passkey hostname|
MCM_WEB_AUTHN_RP_ORIGIN|Passkey browser origins|Automatic (localhost)
MCM_WEB_AUTHN_RP_NAME|Passkey display name|
MCM_HTTP_ONLY|Serve plain HTTP|false
MCM_TLS|Force secure cookies behind proxy|false
MCM_TLS_CERT|TLS certificate|Automatic self-signed certificate when HTTPS is enabled
MCM_TLS_KEY|TLS private key file|Automatic when HTTPS is enabled
MCM_TLS_REDIRECT|Redirect HTTP to HTTPS|false
MCM_DEFAULT_CPU_LIMIT|Default CPU limit|0 (unlimited)
MCM_DEFAULT_MEMORY_MB|Default memory limit (MiB)|0 (unlimited)
MCM_SERVER_IMAGE|Minecraft runtime image|
MCM_S3_ENDPOINT|S3 endpoint|Disabled
MCM_S3_BUCKET|S3 bucket|Unset
MCM_S3_REGION|S3 region|us-east-1
MCM_LOGIN_MAX_ATTEMPTS|Failed logins before lockout|5
MCM_LOGIN_LOCKOUT|Login lockout|15m
MCM_RATE_LIMIT_MAX|Requests per client per window|100
MCM_RATE_LIMIT_WINDOW|Request rate window|1m
FIELDS
    while IFS='|' read -r key label; do
        value=$(setting "$key")
        if [[ -n "$value" ]]; then value='<saved; hidden>'; else value='<unset>'; fi
        printf '  %s: %s\n' "$label" "$value"
    done <<'SECRETS'
MCM_S3_ACCESS_KEY|S3 access key
MCM_S3_SECRET_KEY|S3 secret key
CURSEFORGE_API_KEY|CurseForge API key
SECRETS
    say "Settings file: $ORIGINAL_CONFIG"
}

guided_config() {
    local step
    say 'MCM guided setup'
    say "Enter keeps the shown value. Use '-' to clear an optional value, or ':cancel' to exit without saving."
    say 'You can revisit any step before saving. Secret input is hidden in a terminal.'
    for step in 1 2 3 4 5 6; do wizard_step "$step"; done
    while true; do
        review_config
        read_answer 'Enter a step (1-6) to edit, save to continue, or cancel [save]: '
        case "${ANSWER:-save}" in
            [1-6]) wizard_step "$ANSWER" ;;
            save) return 0 ;;
            cancel) cancel_setup ;;
            *) say 'Choose a step number, save, or cancel.' ;;
        esac
    done
}

load_state() {
    local key value
    [[ -f "$STATE" ]] || die "MCM is not installed. Run ./mcmctl install from the project checkout."
    while IFS='=' read -r key value; do
        [[ "$key" != SOURCE_DIR ]] || SOURCE_DIR="$value"
    done < "$STATE"
    [[ -n "$SOURCE_DIR" ]] || die "Installation metadata is incomplete: $STATE"
}

command_source_dir() {
    local directory
    directory=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || return 1
    [[ -f "$directory/Dockerfile" && -f "$directory/go.mod" && -f "$directory/mcmctl" ]] || return 1
    printf '%s' "$directory"
}

save_state() {
    local temp
    temp=$(mktemp "$CONFIG_DIR/.install.XXXXXX")
    printf 'SOURCE_DIR=%s\n' "$SOURCE_DIR" > "$temp"
    mv -f -- "$temp" "$STATE"
}

check_config_paths() {
    local data_dir db_path db_dir backup_dir
    data_dir=$(setting MCM_DATA_DIR)
    absolute_path "$data_dir"
    db_path=$(setting MCM_DB_PATH)
    [[ -n "$db_path" ]] || db_path="$data_dir/mcm.db"
    absolute_path "$db_path"
    if ! mkdir -p -- "$data_dir" || [[ ! -w "$data_dir" || ! -x "$data_dir" ]]; then
        die "MCM_DATA_DIR is not writable: $data_dir. Choose a writable absolute directory in $CONFIG."
    fi
    db_dir=$(dirname -- "$db_path")
    # SQLite also writes journal/WAL files beside the database.
    if ! mkdir -p -- "$db_dir" || [[ ! -w "$db_dir" || ! -x "$db_dir" ]] ||
        [[ -e "$db_path" && ( ! -f "$db_path" || ! -r "$db_path" || ! -w "$db_path" ) ]]; then
        die "Cannot write the SQLite database at $db_path. Edit $CONFIG: leave MCM_DB_PATH empty to use MCM_DATA_DIR/mcm.db, or set a writable absolute database path."
    fi
    backup_dir=$(setting MCM_BACKUP_DIR)
    if [[ -n "$backup_dir" ]]; then
        absolute_path "$backup_dir"
        if ! mkdir -p -- "$backup_dir" || [[ ! -w "$backup_dir" || ! -x "$backup_dir" ]]; then
            die "MCM_BACKUP_DIR is not writable: $backup_dir. Mount the backup media and choose a writable absolute directory in $CONFIG."
        fi
    fi
}

lock_installation() {
    need flock
    mkdir -p "$CONFIG_DIR"
    chmod 700 "$CONFIG_DIR"
    exec 9>"$CONFIG_DIR/.lock"
    flock -n 9 || die "Another MCM installation or update is running."
}

prepare_engine() {
    need "$ENGINE"
    if [[ "$ENGINE" == podman ]]; then
        systemctl --user enable --now podman.socket
        local socket="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
        [[ -S "$socket" ]] || die "Podman's API socket is missing: $socket. Check: systemctl --user status podman.socket"
    fi
    "$ENGINE" info >/dev/null || die "$ENGINE is not accessible to your user. Check its installation and permissions."
}

ensure_runtime_image() {
    local image
    image=$(setting MCM_SERVER_IMAGE)
    [[ -n "$image" ]] || image=docker.io/library/eclipse-temurin:21-jre-alpine
    if ! "$ENGINE" image inspect "$image" >/dev/null 2>&1; then
        say "Downloading the Minecraft runtime image."
        "$ENGINE" pull "$image"
    fi
}

prepare_config() {
    local data_dir="$1" port="$2" backup_dir="$3"
    mkdir -p "$CONFIG_DIR" "$BIN_DIR" "$UNIT_DIR"
    touch "$CONFIG"
    chmod 600 "$CONFIG"
    [[ -n "$(setting MCM_CONTAINER_RUNTIME)" ]] || set_setting MCM_CONTAINER_RUNTIME "$ENGINE"
    [[ -z "$data_dir" ]] || set_setting MCM_DATA_DIR "$data_dir"
    [[ -n "$(setting MCM_DATA_DIR)" ]] || set_setting MCM_DATA_DIR "${XDG_DATA_HOME:-$HOME/.local/share}/mcm"
    [[ -z "$backup_dir" ]] || set_setting MCM_BACKUP_DIR "$backup_dir"
    [[ -z "$port" ]] || set_setting MCM_ADDR ":$port"
    [[ -n "$(setting MCM_ADDR)" ]] || set_setting MCM_ADDR :8080
    if [[ -z "$(setting MCM_CONTAINER_HOST)" ]]; then
        if [[ "$ENGINE" == podman ]]; then
            set_setting MCM_CONTAINER_HOST "unix://${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
        else
            set_setting MCM_CONTAINER_HOST "${DOCKER_HOST:-unix:///var/run/docker.sock}"
        fi
    fi
    check_config_paths
}

build_app() {
    [[ -f "$SOURCE_DIR/Dockerfile" && -f "$SOURCE_DIR/mcmctl" ]] || die "Source checkout is missing: $SOURCE_DIR"
    STAGING=$(mktemp -d "$BIN_DIR/.mcm-build.XXXXXX")
    say "Building MCM and its web interface with $ENGINE. The running panel stays up during the build."
    local image="localhost/mcm-build:$(id -u)" build_commit=unknown build_dirty=false
    if command -v git >/dev/null 2>&1; then
        build_commit=$(git -C "$SOURCE_DIR" rev-parse HEAD 2>/dev/null) || build_commit=unknown
        [[ -n "$build_commit" ]] || build_commit=unknown
        [[ -z "$(git -C "$SOURCE_DIR" status --porcelain 2>/dev/null)" ]] || build_dirty=true
    fi
    "$ENGINE" build --target go --tag "$image" \
        --build-arg "MCM_BUILD_COMMIT=$build_commit" --build-arg "MCM_BUILD_DIRTY=$build_dirty" \
        --build-arg "MCM_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --file "$SOURCE_DIR/Dockerfile" "$SOURCE_DIR"
    BUILD_CONTAINER=$("$ENGINE" create --entrypoint /bin/true "$image")
    "$ENGINE" cp "$BUILD_CONTAINER:/out/mcm" "$STAGING/mcm"
    "$ENGINE" rm "$BUILD_CONTAINER" >/dev/null
    BUILD_CONTAINER=""
    [[ -s "$STAGING/mcm" ]] || die "The build did not produce an MCM binary."
    chmod 755 "$STAGING/mcm"
}

unit_path() {
    # Path directives consume the whole value; quotes would become path bytes.
    # Literal percent signs still need escaping for systemd specifiers.
    printf '%s' "${1//%/%%}"
}

unit_exec_path() {
    # ExecStart uses command-line parsing, so its executable may be quoted.
    printf '"%s"' "$(unit_path "$1")"
}

write_unit() {
    {
        say '# Managed by mcmctl. Change application settings in mcm.env.'
        say '[Unit]'
        say 'Description=MCM - Minecraft Container Manager'
        if [[ "$ENGINE" == podman ]]; then
            say 'After=podman.socket'
            say 'Requires=podman.socket'
        fi
        say ''
        say '[Service]'
        printf 'ExecStart=%s\n' "$(unit_exec_path "$BIN_DIR/mcm")"
        printf 'EnvironmentFile=%s\n' "$(unit_path "$CONFIG")"
        printf 'Environment="XDG_CONFIG_HOME=%s"\n' "$(unit_path "$(dirname -- "$CONFIG_DIR")")"
        printf 'WorkingDirectory=%s\n' "$(unit_path "$HOME")"
        say 'Restart=on-failure'
        say 'RestartSec=5'
        say 'TimeoutStopSec=90'
        say ''
        say '[Install]'
        say 'WantedBy=default.target'
    } > "$UNIT"
}

wait_ready() {
    local address port host scheme=https attempt ready_count=0 ready
    local allow_legacy_http="${1:-false}"
    local -a tls_args=()
    address=$(setting MCM_ADDR)
    port="${address##*:}"
    host="${address%:*}"
    [[ -n "$host" && "$host" != 0.0.0.0 && "$host" != '[::]' ]] || host=127.0.0.1
    case "$(setting MCM_HTTP_ONLY)" in
        1|t|T|true|TRUE|True) scheme=http ;;
    esac
    if [[ "$scheme" == https && -z "$(setting MCM_TLS_CERT)" ]]; then
        tls_args=(--cacert "$(setting MCM_DATA_DIR)/tls/cert.pem")
    fi
    for ((attempt=0; attempt<30; attempt++)); do
        ready=false
        if systemctl --user is-active --quiet mcm.service; then
            if curl --noproxy '*' --fail --silent --max-time 2 ${tls_args[@]+"${tls_args[@]}"} "$scheme://$host:$port/readyz" >/dev/null; then
                ready=true
            elif [[ "$allow_legacy_http" == true && "$scheme" == https && -z "$(setting MCM_TLS_CERT)" ]] &&
                curl --noproxy '*' --fail --silent --max-time 2 "http://$host:$port/readyz" >/dev/null; then
                # Only a restored pre-HTTPS binary may use the legacy probe.
                scheme=http
                tls_args=()
                ready=true
            fi
        fi
        if [[ "$ready" == true ]]; then
            ready_count=$((ready_count + 1))
            if ((ready_count >= 2)); then
                say "MCM is ready at $scheme://$host:$port"
                return 0
            fi
        else
            ready_count=0
        fi
        sleep 1
    done
    journalctl --user -u mcm.service -n 30 --no-pager >&2 || true
    return 1
}

snapshot() {
    local backup db_path suffix
    backup=$(mktemp -d "$CONFIG_DIR/backups/update-$(date +%Y%m%d-%H%M%S)-XXXXXX") || return 1
    cp -p -- "$CONFIG" "$backup/mcm.env" || return 1
    for suffix in mcm mcmctl; do
        [[ ! -f "$BIN_DIR/$suffix" ]] || cp -p -- "$BIN_DIR/$suffix" "$backup/$suffix" || return 1
    done
    [[ ! -f "$UNIT" ]] || cp -p -- "$UNIT" "$backup/mcm.service" || return 1
    db_path=$(setting MCM_DB_PATH)
    [[ -n "$db_path" ]] || db_path="$(setting MCM_DATA_DIR)/mcm.db"
    absolute_path "$db_path"
    printf '%s\n' "$db_path" > "$backup/database-path" || return 1
    for suffix in '' -wal -shm; do
        [[ ! -f "$db_path$suffix" ]] || cp -p -- "$db_path$suffix" "$backup/database$suffix" || return 1
    done
    printf '%s\n' "$backup" > "$CONFIG_DIR/last-backup" || return 1
    say "Panel backup saved: $backup"
}

restore_snapshot() {
    local backup db_path suffix
    [[ -f "$CONFIG_DIR/last-backup" ]] || die "No panel backup is available."
    IFS= read -r backup < "$CONFIG_DIR/last-backup"
    [[ -f "$backup/mcm" ]] || die "This backup has no installed binary: $backup"
    systemctl --user stop mcm.service || return 1
    cp -p -- "$backup/mcm" "$BIN_DIR/.mcm-restore" || return 1
    mv -f -- "$BIN_DIR/.mcm-restore" "$BIN_DIR/mcm" || return 1
    cp -p -- "$backup/mcm.env" "$CONFIG" || return 1
    [[ ! -f "$backup/mcm.service" ]] || cp -p -- "$backup/mcm.service" "$UNIT" || return 1
    [[ ! -f "$backup/mcmctl" ]] || cp -p -- "$backup/mcmctl" "$BIN_DIR/.mcmctl-restore" || return 1
    [[ ! -f "$BIN_DIR/.mcmctl-restore" ]] || mv -f -- "$BIN_DIR/.mcmctl-restore" "$BIN_DIR/mcmctl" || return 1
    IFS= read -r db_path < "$backup/database-path"
    # Restore a database only when one existed before the update.
    if [[ -f "$backup/database" ]]; then
        absolute_path "$db_path"
        for suffix in '' -wal -shm; do
            rm -f -- "$db_path$suffix" || return 1
            [[ ! -f "$backup/database$suffix" ]] || cp -p -- "$backup/database$suffix" "$db_path$suffix" || return 1
        done
    fi
    systemctl --user daemon-reload || return 1
    systemctl --user reset-failed mcm.service || return 1
    systemctl --user start mcm.service || return 1
    wait_ready true
}

enable_boot() {
    systemctl --user enable mcm.service
    if command -v loginctl >/dev/null 2>&1 && [[ $(loginctl show-user "$(id -u)" --property=Linger --value 2>/dev/null) != yes ]]; then
        if ! loginctl enable-linger "$(id -un)"; then
            say "To run MCM after logout and at boot, run: sudo loginctl enable-linger $(id -un)"
        fi
    fi
}

install_app() {
    local requested_engine="" data_dir="" backup_dir="" port="" flag interactive=auto staged_config host scheme
    while (($#)); do
        flag="$1"; shift
        case "$flag" in
            --interactive|--non-interactive)
                [[ "$interactive" == auto ]] || die 'Choose only one of --interactive and --non-interactive.'
                interactive=false; [[ "$flag" != --interactive ]] || interactive=true
                continue
                ;;
            --help|-h) usage; return 0 ;;
            --runtime|--data-dir|--backup-dir|--port) (($#)) || die "Missing value for $flag" ;;
            *) die "Unknown option: $flag" ;;
        esac
        case "$flag" in
            --runtime) requested_engine="$1" ;;
            --data-dir) data_dir="$1"; absolute_path "$data_dir" ;;
            --backup-dir) backup_dir="$1"; absolute_path "$backup_dir" ;;
            --port)
                port="$1"
                [[ "$port" =~ ^[0-9]{1,5}$ ]] || die "Port must be between 1024 and 65535."
                port=$((10#$port))
                [[ "$port" -gt 1023 && "$port" -le 65535 ]] || die "Port must be between 1024 and 65535."
                ;;
        esac
        shift
    done
    if [[ "$interactive" == auto ]]; then
        interactive=false; [[ ! -t 0 ]] || interactive=true
    fi
    SOURCE_DIR=$(command_source_dir) || load_state
    EXISTING_ENGINE=$(setting MCM_CONTAINER_RUNTIME)
    ENGINE="${requested_engine:-$EXISTING_ENGINE}"
    if [[ -z "$ENGINE" ]]; then
        if command -v podman >/dev/null 2>&1; then ENGINE=podman; else ENGINE=docker; fi
    fi
    [[ "$ENGINE" == podman || "$ENGINE" == docker ]] || die "Runtime must be podman or docker."
    if [[ -n "$requested_engine" && -n "$EXISTING_ENGINE" && "$requested_engine" != "$EXISTING_ENGINE" ]]; then
        die "Config uses $EXISTING_ENGINE. Change MCM_CONTAINER_RUNTIME and MCM_CONTAINER_HOST in $CONFIG before switching engines."
    fi
    if [[ "$interactive" == true ]]; then
        begin_config_edit
        [[ -z "$data_dir" ]] || set_setting MCM_DATA_DIR "$data_dir"
        [[ -z "$backup_dir" ]] || set_setting MCM_BACKUP_DIR "$backup_dir"
        [[ -z "$port" ]] || set_setting MCM_ADDR ":$port"
        # An explicit flag takes priority as the runtime prompt's default.
        [[ -z "$requested_engine" ]] || set_setting MCM_CONTAINER_RUNTIME "$requested_engine"
        guided_config
        data_dir=""; backup_dir=""; port=""
    else
        say 'Using unattended setup. Run install --interactive for guided configuration.'
    fi
    say 'Installation 1/5 - Checking the container engine and API socket.'
    prepare_engine
    if [[ $("$ENGINE" inspect --format '{{.State.Running}}' mcm 2>/dev/null || true) == true ]]; then
        die "A panel container named mcm is running. Stop it with '$ENGINE stop mcm', then retry with --data-dir pointing to its existing host data directory."
    fi
    say 'Installation 2/5 - Preparing settings and checking storage.'
    prepare_config "$data_dir" "$port" "$backup_dir"
    say 'Installation 3/5 - Downloading images and building the panel.'
    ensure_runtime_image
    build_app
    mkdir -p "$CONFIG_DIR/backups"
    # Capture the stopped database, including any residual SQLite WAL.
    if [[ -f "$UNIT" ]] || systemctl --user is-active --quiet mcm.service; then
        systemctl --user stop mcm.service
    fi
    # Back up the previous configuration and its database, not the wizard draft.
    staged_config="$CONFIG"
    [[ "$interactive" != true || ! -f "$ORIGINAL_CONFIG" ]] || CONFIG="$ORIGINAL_CONFIG"
    if [[ -f "$BIN_DIR/mcm" ]] && ! snapshot; then
        systemctl --user start mcm.service || true
        die 'Could not back up the installed version. Installation stopped.'
    fi
    CONFIG="$staged_config"
    [[ "$interactive" != true ]] || commit_config_edit
    say 'Installation 4/5 - Installing and enabling the user service.'
    [[ ! -f "$UNIT" ]] || cp -p -- "$UNIT" "$CONFIG_DIR/previous.service"
    mv -f -- "$STAGING/mcm" "$BIN_DIR/mcm"
    cp -- "$SOURCE_DIR/mcmctl" "$STAGING/mcmctl"
    chmod 755 "$STAGING/mcmctl"
    mv -f -- "$STAGING/mcmctl" "$BIN_DIR/mcmctl"
    save_state
    write_unit
    systemctl --user daemon-reload
    systemctl --user reset-failed mcm.service
    enable_boot
    say 'Installation 5/5 - Starting MCM and waiting for it to become ready.'
    if ! systemctl --user start mcm.service || ! wait_ready; then
        die "MCM could not start. Inspect: $BIN_DIR/mcmctl logs. Your settings and server data are retained."
    fi
    say "Installed. Manage MCM with: $BIN_DIR/mcmctl status"
    say "Settings: $CONFIG"
    say "Server data: $(setting MCM_DATA_DIR)"
    backup_dir=$(setting MCM_BACKUP_DIR)
    say "Server backups: ${backup_dir:-$(setting MCM_DATA_DIR)/backups}"
    host=$(setting MCM_ADDR); port="${host##*:}"; host="${host%:*}"
    case "$host" in ''|0.0.0.0|'[::]') host=YOUR_SERVER_IP ;; esac
    scheme=https
    case "$(setting MCM_HTTP_ONLY)" in 1|t|T|true|TRUE|True) scheme=http ;; esac
    say "Open $scheme://$host:$port in your browser; onboarding creates the first administrator."
    if [[ "$scheme" == https && -z "$(setting MCM_TLS_CERT)" ]]; then
        say "Trust the public certificate at $(setting MCM_DATA_DIR)/tls/cert.pem to remove the browser warning. Keep key.pem private."
    fi
    say "Allow the panel port and published Minecraft ports through your host firewall. Edit settings later with: $BIN_DIR/mcmctl config"
}

configure_app() {
    [[ -f "$CONFIG" ]] || die 'Run ./mcmctl install first.'
    if [[ $# == 1 && "$1" == --editor ]]; then
        exec "${EDITOR:-vi}" "$CONFIG"
    fi
    [[ $# == 0 || ( $# == 1 && "$1" == --interactive ) ]] || die 'Usage: mcmctl config [--interactive|--editor]'
    [[ -t 0 || $# == 1 ]] || die 'Guided config needs a terminal. Use config --interactive for piped answers, or config --editor for a text editor.'
    EXISTING_ENGINE=$(setting MCM_CONTAINER_RUNTIME)
    ENGINE="${EXISTING_ENGINE:-podman}"
    begin_config_edit
    guided_config
    prepare_config '' '' ''
    commit_config_edit
    say "Settings saved: $CONFIG"
    say 'Changing storage paths does not move data. Restart the panel to apply saved settings.'
    if [[ -f "$UNIT" ]]; then
        ask_yes_no 'Restart MCM now to apply these settings?' false
        if [[ "$ANSWER" == true ]]; then
            systemctl --user restart mcm.service
            wait_ready || die 'MCM did not become ready. Check mcmctl logs or restore the saved settings backup.'
            return 0
        fi
    fi
    say 'Apply when ready with: mcmctl restart'
}

update_source() {
    local changes branch remote merge
    need git
    say "Updating source checkout: $SOURCE_DIR"
    changes=$(git -C "$SOURCE_DIR" status --porcelain) || die "Cannot inspect the source checkout: $SOURCE_DIR"
    [[ -z "$changes" ]] || die "The checkout has local changes. Commit or stash them, or use mcmctl update --local to build them."
    branch=$(git -C "$SOURCE_DIR" symbolic-ref --quiet --short HEAD) ||
        die "The source checkout has a detached HEAD. Check out a branch in $SOURCE_DIR, or use mcmctl update --local."
    remote=$(git -C "$SOURCE_DIR" config --get "branch.$branch.remote" || true)
    merge=$(git -C "$SOURCE_DIR" config --get "branch.$branch.merge" || true)
    if [[ -n "${MCM_UPDATE_COMMIT:-}" ]]; then
        [[ "$MCM_UPDATE_COMMIT" =~ ^[0-9a-f]{40}$ ]] || die 'Invalid approved update commit.'
        [[ -n "$remote" && -n "$merge" ]] || die 'Pinned updates require a configured upstream.'
        git -C "$SOURCE_DIR" fetch "$remote" "$merge"
        git -C "$SOURCE_DIR" merge-base --is-ancestor "$MCM_UPDATE_COMMIT" FETCH_HEAD || die 'Approved commit is not in the tracked upstream history.'
        git -C "$SOURCE_DIR" merge --ff-only "$MCM_UPDATE_COMMIT"
        [[ "$(git -C "$SOURCE_DIR" rev-parse HEAD)" == "$MCM_UPDATE_COMMIT" ]] || die 'Checkout differs from approved commit.'
        return
    fi
    if [[ -n "$remote" && -n "$merge" ]]; then
        git -C "$SOURCE_DIR" pull --ff-only
    else
        git -C "$SOURCE_DIR" remote get-url origin >/dev/null 2>&1 ||
            die "No origin remote exists in $SOURCE_DIR. Run ./mcmctl update from your source checkout, or correct SOURCE_DIR in $STATE. Use --local only to build this source without pulling."
        say "No upstream configured for $branch; using origin/$branch."
        git -C "$SOURCE_DIR" pull --ff-only origin "refs/heads/$branch"
    fi
}

update_app() {
    local local_build=false command_source
    if (($#)); then
        case "$1" in
            --local) [[ $# == 1 ]] || die 'Usage: mcmctl update [--local|--commit SHA]'; local_build=true ;;
            --commit) [[ $# == 2 && "$2" =~ ^[0-9a-f]{40}$ ]] || die 'Invalid approved update commit.'; MCM_UPDATE_COMMIT="$2" ;;
            *) die 'Usage: mcmctl update [--local|--commit SHA]' ;;
        esac
    fi
    load_state
    command_source=$(command_source_dir) || command_source=""
    if [[ -n "$command_source" && "$command_source" != "$SOURCE_DIR" ]]; then
        say "Using source checkout: $command_source (replacing recorded path: $SOURCE_DIR)"
        SOURCE_DIR="$command_source"
    fi
    ENGINE=$(setting MCM_CONTAINER_RUNTIME)
    check_config_paths
    prepare_engine
    if [[ "$local_build" == false ]]; then
        update_source
    fi
    ensure_runtime_image
    build_app
    if [[ -n "${MCM_UPDATE_COMMIT:-}" ]]; then
        [[ "$(git -C "$SOURCE_DIR" rev-parse HEAD)" == "$MCM_UPDATE_COMMIT" ]] || die 'Checkout changed during build.'
        "$STAGING/mcm" --version | tr -d ' ' | grep -Fq "\"commit\":\"$MCM_UPDATE_COMMIT\"" || die 'Built binary differs from approved commit.'
    fi
    mkdir -p "$CONFIG_DIR/backups"
    systemctl --user stop mcm.service
    if ! snapshot; then
        systemctl --user start mcm.service || true
        die 'Could not back up the installed version. Update stopped.'
    fi
    mv -f -- "$STAGING/mcm" "$BIN_DIR/mcm"
    if ! systemctl --user start mcm.service || ! wait_ready; then
        say "The update did not become ready. Restoring the previous binary, config, and panel database."
        restore_snapshot || die "Rollback needs attention. Inspect: mcmctl logs"
        die "The update failed; the previous version is running."
    fi
    cp -- "$SOURCE_DIR/mcmctl" "$STAGING/mcmctl"
    chmod 755 "$STAGING/mcmctl"
    mv -f -- "$STAGING/mcmctl" "$BIN_DIR/mcmctl"
    save_state
    say 'Update complete. Existing settings and server files were preserved.'
}

command="${1:-help}"
[[ $# == 0 ]] || shift
case "$command" in help|-h|--help) usage; exit 0 ;; esac
[[ $(uname -s) == Linux ]] || die "The service installer requires Linux with systemd. See README for Docker Compose and macOS setup."
[[ $(id -u) != 0 ]] || die "Run mcmctl as your normal user, without sudo."
need systemctl
absolute_path "$CONFIG_DIR"
absolute_path "$BIN_DIR"
case "$command" in
    install|update|rollback|backup|uninstall|config) lock_installation ;;
esac
case "$command" in
    install|update|rollback) need curl ;;
esac
case "$command" in
    install) install_app "$@" ;;
    update) update_app "$@" ;;
    start|stop|restart|status) systemctl --user "$command" mcm.service ;;
    logs) exec journalctl --user -u mcm.service -n 100 -f ;;
    config) configure_app "$@" ;;
    enable) enable_boot ;;
    disable) systemctl --user disable mcm.service ;;
    backup)
        load_state
        check_config_paths
        mkdir -p "$CONFIG_DIR/backups"
        was_active=false
        systemctl --user is-active --quiet mcm.service && was_active=true
        systemctl --user stop mcm.service
        if ! snapshot; then
            [[ "$was_active" != true ]] || systemctl --user start mcm.service
            die 'Backup failed.'
        fi
        [[ "$was_active" != true ]] || systemctl --user start mcm.service
        ;;
    rollback) restore_snapshot ;;
    uninstall)
        systemctl --user disable --now mcm.service
        rm -f -- "$UNIT" "$BIN_DIR/mcm" "$BIN_DIR/mcmctl" "$STATE"
        systemctl --user daemon-reload
        say "MCM removed. Settings and backups remain in $CONFIG_DIR; server data is retained."
        ;;
    *) usage >&2; die "Unknown command: $command" ;;
esac
